# 開発用の設定。`cp .env.example .env` の後、REPLACE_ME を次のコマンドの出力で置き換える:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
DATABASE_URL=postgres://diary:diary@localhost:5432/diary
APP_ORIGIN=https://localhost:5173
RP_ID=localhost
RP_NAME=diary-log
# 形式: <バージョン>:<base64 の32バイト鍵>(複数はカンマ区切り)
DATA_ENCRYPTION_KEYS=1:REPLACE_ME
ACTIVE_KEY_VERSION=1
HMAC_SECRET=REPLACE_ME
SMTP_URL=smtp://localhost:1025
MAIL_FROM=diary-log <no-reply@localhost>
PORT=3000
